{
  "info": {"name": "Stacklab Technologies API", "description": "Auth, RBAC, project/task lifecycle, notification, reporting, and stale-version conflict flow.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "baseUrl", "value": "http://localhost:8080"}, {"key": "demoPassword", "value": ""}, {"key": "employeeToken", "value": ""}, {"key": "managerToken", "value": ""}, {"key": "adminToken", "value": ""}, {"key": "taskId", "value": "1"}, {"key": "taskVersion", "value": "0"}, {"key": "projectId", "value": "1"}, {"key": "employeeId", "value": "4"}, {"key": "managedUserId", "value": ""}, {"key": "notificationId", "value": ""}],
  "item": [
    {"name": "Auth", "item": [
      {"name": "Register employee", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/auth/register", "body": {"mode": "raw", "raw": "{\n  \"name\": \"New Employee\",\n  \"email\": \"new.employee@example.test\",\n  \"password\": \"{{demoPassword}}\"\n}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('created employee', () => pm.response.to.have.status(201));"]}}]},
      {"name": "Login employee", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/auth/login", "body": {"mode": "raw", "raw": "{\n  \"email\": \"sam@stacklab.local\",\n  \"password\": \"{{demoPassword}}\"\n}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('employeeToken', pm.response.json().token);"]}}]},
      {"name": "Login manager", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/auth/login", "body": {"mode": "raw", "raw": "{\n  \"email\": \"maya@stacklab.local\",\n  \"password\": \"{{demoPassword}}\"\n}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('managerToken', pm.response.json().token);"]}}]},
      {"name": "Login admin", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/auth/login", "body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@stacklab.local\",\n  \"password\": \"{{demoPassword}}\"\n}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('adminToken', pm.response.json().token);"]}}]}
    ]},
    {"name": "RBAC and users", "item": [
      {"name": "Employee cannot list users (403)", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{employeeToken}}"}], "url": "{{baseUrl}}/api/users"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('employee denied', () => pm.response.to.have.status(403));"]}}]},
      {"name": "List users (admin)", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}], "url": "{{baseUrl}}/api/users?q=employee&page=0&size=20"}},
      {"name": "Create user (admin)", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/users", "body": {"mode": "raw", "raw": "{\"name\":\"Imported User\",\"email\":\"imported@example.test\",\"password\":\"{{demoPassword}}\",\"role\":\"EMPLOYEE\"}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('created by admin', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('managedUserId', pm.response.json().id);"]}}]},
      {"name": "Get created user", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}], "url": "{{baseUrl}}/api/users/{{managedUserId}}"}},
      {"name": "Update created user", "request": {"method": "PUT", "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/users/{{managedUserId}}", "body": {"mode": "raw", "raw": "{\"name\":\"Updated Imported User\",\"active\":true}", "options": {"raw": {"language": "json"}}}}}
    ]},
    {"name": "Projects and tasks", "item": [
      {"name": "List projects", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}], "url": "{{baseUrl}}/api/projects?page=0&size=20"}},
      {"name": "Create project", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/projects", "body": {"mode": "raw", "raw": "{\"name\":\"Postman project\",\"description\":\"API demo\",\"managerId\":2}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('project created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('projectId', pm.response.json().id);"]}}]},
      {"name": "Get project", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}], "url": "{{baseUrl}}/api/projects/{{projectId}}"}},
      {"name": "Project activity history", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}], "url": "{{baseUrl}}/api/projects/{{projectId}}/activity"}},
      {"name": "Create task", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/tasks", "body": {"mode": "raw", "raw": "{\"title\":\"Postman workflow\",\"description\":\"Exercise assignment\",\"assigneeId\":{{employeeId}},\"projectId\":{{projectId}},\"deadline\":\"2030-01-01T00:00:00Z\",\"priority\":\"HIGH\",\"status\":\"TO_DO\"}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('task created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('taskId', pm.response.json().id);", "pm.collectionVariables.set('taskVersion', pm.response.json().version);"]}}]},
      {"name": "Filter overdue tasks", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}], "url": "{{baseUrl}}/api/tasks?overdue=true&priority=HIGH&page=0&size=20"}},
      {"name": "Get task details", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}], "url": "{{baseUrl}}/api/tasks/{{taskId}}"}},
      {"name": "Update status to complete", "request": {"method": "PUT", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/tasks/{{taskId}}", "body": {"mode": "raw", "raw": "{\"version\":{{taskVersion}},\"status\":\"COMPLETED\"}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('task completed', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('taskVersion', pm.response.json().version);"]}}]},
      {"name": "Conflict flow - first update with current version", "request": {"method": "PUT", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/tasks/{{taskId}}", "body": {"mode": "raw", "raw": "{\"version\":{{taskVersion}},\"status\":\"IN_PROGRESS\"}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('first update accepted', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('conflictingVersion', pm.collectionVariables.get('taskVersion'));", "pm.collectionVariables.set('taskVersion', pm.response.json().version);"]}}]},
      {"name": "Conflict flow - stale version returns 409", "request": {"method": "PUT", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/tasks/{{taskId}}", "body": {"mode": "raw", "raw": "{\"version\":{{conflictingVersion}},\"status\":\"REVIEW\"}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('stale version conflicts', () => pm.response.to.have.status(409));", "pm.test('conflict explains reload', () => pm.expect(pm.response.json().message).to.include('reload'));"]}}]},
      {"name": "Task activity history", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}], "url": "{{baseUrl}}/api/tasks/{{taskId}}/activity"}},
      {"name": "Delete task", "request": {"method": "DELETE", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}], "url": "{{baseUrl}}/api/tasks/{{taskId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('task deleted', () => pm.response.to.have.status(200));"]}}]}
    ]},
    {"name": "Notifications and analytics", "item": [
      {"name": "My notifications", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{employeeToken}}"}], "url": "{{baseUrl}}/api/notifications"}, "event": [{"listen": "test", "script": {"exec": ["if (pm.response.code === 200 && pm.response.json().length) pm.collectionVariables.set('notificationId', pm.response.json()[0].id);"]}}]},
      {"name": "Mark my notification read", "request": {"method": "PATCH", "header": [{"key": "Authorization", "value": "Bearer {{employeeToken}}"}], "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read"}},
      {"name": "Analytics overview", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}], "url": "{{baseUrl}}/api/analytics"}},
      {"name": "Analytics breakdown", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}], "url": "{{baseUrl}}/api/analytics/breakdown"}},
      {"name": "Employee performance", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}], "url": "{{baseUrl}}/api/analytics/employees/{{employeeId}}/performance"}},
      {"name": "Archive project (manager)", "request": {"method": "PUT", "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/projects/{{projectId}}", "body": {"mode": "raw", "raw": "{\"name\":\"Postman project\",\"description\":\"API demo\",\"managerId\":2,\"archived\":true}", "options": {"raw": {"language": "json"}}}}},
      {"name": "Deactivate employee (admin)", "request": {"method": "DELETE", "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}], "url": "{{baseUrl}}/api/users/{{employeeId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('deactivated', () => pm.response.to.have.status(204));"]}}]},
      {"name": "Deactivate created user (admin)", "request": {"method": "DELETE", "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}], "url": "{{baseUrl}}/api/users/{{managedUserId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('created user deactivated', () => pm.response.to.have.status(204));"]}}]}
    ]}
  ]
}
